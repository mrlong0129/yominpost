# YominPost configuration. EVERYTHING HERE IS OPTIONAL: with no env vars the app runs offline
# (template driver), stores data in ~/.yominpost/ and listens on http://127.0.0.1:8300.
# Copy to ~/.yominpost.env (used by deploy/serve.sh) or export in your shell.

# ---- Data location ----
# YOMINPOST_HOME=~/.yominpost                 # root for data/ and artifacts/
# YOMINPOST_DATA_DIR=~/.yominpost/data        # SQLite DB + .secret.key (back them up together!)
# YOMINPOST_ARTIFACT_DIR=~/.yominpost/artifacts
# YOMINPOST_DB=~/.yominpost/data/yominpost.db

# ---- Generation driver (also switchable on the Settings page) ----
# YOMINPOST_PROVIDER=template                 # template | claude_code | codex | agy | anthropic
# YOMINPOST_MODEL=haiku                       # model alias for the claude CLI driver (haiku/sonnet/opus)
# YOMINPOST_ANTHROPIC_MODEL=                  # full model id for the anthropic API driver
# ANTHROPIC_API_KEY=
# YOMINPOST_CLI_TASKS=copy,ideation           # which slots CLI drivers run (others stay deterministic)
# YOMINPOST_CLI_TIMEOUT=120

# ---- Image generation (optional; built-in SVG/JPG poster renderer otherwise) ----
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# YOMINPOST_IMAGE_BASE_URL=                   # any OpenAI-compatible endpoint
# YOMINPOST_IMAGE_API_KEY=

# ---- OAuth apps for one-click Connect (register once; callback = <your URL>/oauth/callback) ----
# e.g. local: http://localhost:8300/oauth/callback. You can also paste these on the Settings page.
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Facebook Page publishing (Meta app)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Instagram Login (separate Instagram app id/secret)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# YouTube (Google Cloud OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord (scope webhook.incoming: pick a server/channel during auth)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Generic fallback naming: YOMINPOST_<PLATFORM>_CLIENT_ID / YOMINPOST_<PLATFORM>_CLIENT_SECRET
# Zero-config platforms (no env needed): Mastodon (self-registers an app on your instance),
# Telegram / Bluesky / Webhook (paste a token or URL in the UI).

# ---- Public deployment ----
# YOMINPOST_PUBLIC_URL=https://post.example.com   # used for OAuth callbacks and public media URLs
# YOMINPOST_ACCESS_KEY=change-me-to-a-long-random-string
#   Required when YOMINPOST_PUBLIC_URL is set: the app refuses to start without it.
# YOMINPOST_HOST=127.0.0.1

# ---- Background jobs ----
# YOMINPOST_ENABLE_SCHEDULER=1                # 0 = off (tests)
# YOMINPOST_TZ=Asia/Shanghai                  # IANA zone for the daily channel sync (default: system zone)
# YOMINPOST_SYNC_HOUR=7                       # local hour of the daily sync
# YOMINPOST_RISK_GATE=1                       # pre-publish risk gate (0 = off)
# YOMINPOST_MAX_UPLOAD_MB=15

# ---- Token encryption key (auto-generated into <DATA_DIR>/.secret.key if unset) ----
# YOMINPOST_SECRET_KEY=
