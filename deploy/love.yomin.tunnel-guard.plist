<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 守护脚本装在 ~/.yominpost(非 Desktop),避开 macOS Sequoia 对 Desktop 的 TCC 限制。
     安装:cp 本文件到 ~/Library/LaunchAgents/ 后 launchctl load -w。源见 deploy/tunnel-guard.sh。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>love.yomin.tunnel-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USER/.yominpost/tunnel-guard.sh</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/YOUR_USER</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/.yominpost/tunnel-guard.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/.yominpost/tunnel-guard.err</string>
</dict>
</plist>
